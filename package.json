{
  "name": "expo-cbl-travel",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package && node ./scripts/clean-expo-android-bin.js",
    "sync-cbl": "node ./scripts/sync-cbl-sdk.js",
    "sync-cbl:check": "node ./scripts/sync-cbl-sdk.js --check",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild": "expo prebuild",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/clean-expo-android-bin.js && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@couchbase/couchbase-lite-react-native": "^1.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.0.14",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "expo": "~55.0.28",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-uuid": "^2.0.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.17",
    "jest": "^30.4.2",
    "jest-expo": "~55.0.20",
    "patch-package": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
